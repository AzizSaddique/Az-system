# ==============================================================================
# Client Frontend Environment Configuration
# ==============================================================================
# NOTE: .env files are gitignored and never deployed to production.
# For production builds, you MUST configure these environment variables in your
# Vercel Project Dashboard (Settings -> Environment Variables), NOT in .env files.
# ==============================================================================

# Cloudflare Turnstile Site Key (Public)
# Obtain from Cloudflare Dashboard -> Turnstile -> Add Widget / Settings
# https://dash.cloudflare.com/?to=/:account/turnstile
# NOTE: Cloudflare official dummy site keys for testing and local development:
# - Always Passes: 1x00000000000000000000AA
# - Always Fails:  2x00000000000000000000AB
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Backend API Base URL
# - For local development: http://localhost:5000 (or empty string if using Vite dev proxy)
# - For production (Vercel Dashboard): https://az-system.onrender.com
# Note: src/config/api.ts includes an automatic production fallback to
# https://az-system.onrender.com if VITE_API_URL is omitted.
VITE_API_URL=http://localhost:5000
