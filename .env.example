# Client Environment Configuration
# Cloudflare Turnstile Site Key (Public)
# Obtain from Cloudflare Dashboard -> Turnstile -> Add Widget / Settings
# https://dash.cloudflare.com/?to=/:account/turnstile
# NOTE: Cloudflare official dummy site keys for testing and local development:
# - Always Passes: 1x00000000000000000000AA
# - Always Fails:  2x00000000000000000000AB
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Backend API Base URL
# For local development: http://localhost:5000 (or empty string if using Vite proxy)
# For production (Vercel): must be set to https://az-system.onrender.com
VITE_API_URL=http://localhost:5000
