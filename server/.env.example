# ==============================================================================
# Backend Server Environment Configuration
# ==============================================================================
# NOTE: .env files are gitignored and never reach Render or other production hosts.
# In production, all required variables must be configured in your
# Render Service Dashboard (Environment -> Environment Variables), NOT in .env files.
# ==============================================================================

# Server Configuration
# Render injects PORT automatically (e.g. 10000); defaults to 3000/5000 if unset.
PORT=5000
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins, or single origin (e.g. FRONTEND_URL or CLIENT_URL)
# In production on Render: set to https://frontend-bay-chi-32.vercel.app
# Note: https://frontend-bay-chi-32.vercel.app and Vercel preview URLs are also allowed by default.
CLIENT_URL=http://localhost:3000
FRONTEND_URL=https://frontend-bay-chi-32.vercel.app

# Resend Email Integration
# Obtain an API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_TO_EMAIL=your_email@domain.com
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Optional Rate Limiting Overrides (Only effective in development/test)
# DEV_CONTACT_RATE_LIMIT=60
# DEV_CHAT_RATE_LIMIT=60

# Google Gemini AI Integration
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
# The backend accepts GEMINI_API_KEY, GOOGLE_API_KEY, or GOOGLE_GENAI_API_KEY.
# NOTE: In production (Render), add GEMINI_API_KEY (and optionally GEMINI_MODEL) directly
# in your Render Dashboard: Service -> Environment -> Environment Variables.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional fallbacks if GEMINI_API_KEY is not set:
# GOOGLE_API_KEY=your_gemini_api_key_here
# GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
# Optional model name (defaults to gemini-3.5-flash-lite):
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloudflare Turnstile Security Protection (Server-Side Secret Key)
# Obtain from Cloudflare Dashboard -> Turnstile -> Add Widget / Settings
# https://dash.cloudflare.com/?to=/:account/turnstile
# NOTE: Cloudflare official dummy secret keys for testing and local development:
# - Always Passes: 1x0000000000000000000000000000000AA
# - Always Fails:  2x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
